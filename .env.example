# ── Tech King Automation — Backend environment ──────────────────────────────
NODE_ENV=production
PORT=4000

# PostgreSQL (create a dedicated database — never reuse Shimba WiFi's DB)
DATABASE_URL=postgres://techking:CHANGE_ME@localhost:5432/tech_king

# Redis (dedicated database index, e.g. /6)
REDIS_URL=redis://localhost:6379/6

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_chars_random
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS (comma separated). Never use * in production.
FRONTEND_URL=https://automation.shimbawifi.xyz
CORS_ORIGINS=https://automation.shimbawifi.xyz,http://localhost:3000

# Session credential TTL (days). After expiry the dashboard shows "Reconnect WhatsApp".
SESSION_CREDENTIAL_TTL_DAYS=7

# Where Baileys session state is stored (VPS disk)
DATA_DIR=./data

# WhatsApp bot identity
WA_BOT_NAME=TECH-KING WHATSAPP BOT

# AI gateway (optional — leave empty to disable AI features)
AI_ENABLED=false
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
